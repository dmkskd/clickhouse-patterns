<clickhouse>
    <!-- Dev-only: default user, no password, reachable from the host.
         MUST live in users.d/ - profile/user settings in config.d/ are ignored. -->
    <profiles>
        <default>
            <!-- Enable refreshable materialized views (kafka-produce-refreshable-mv). -->
            <allow_experimental_refreshable_materialized_view>1</allow_experimental_refreshable_materialized_view>
            <!-- Enable Keeper-backed Kafka offsets / StorageKafka2 (kafka-ingest-sharded-partition-affinity). -->
            <allow_experimental_kafka_offsets_storage_in_keeper>1</allow_experimental_kafka_offsets_storage_in_keeper>
        </default>
    </profiles>
    <users>
        <default>
            <password></password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
            <named_collection_control>1</named_collection_control>
        </default>
    </users>
</clickhouse>
