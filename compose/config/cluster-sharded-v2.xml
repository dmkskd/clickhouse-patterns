<clickhouse>
    <!-- Same two-shard topology as cluster-sharded.xml, but pointing at the
         head-image nodes (ch-s1v2, ch-s2v2). Kept separate so the stable
         `shards` patterns keep their pinned 26.7 image while the experimental
         StorageKafka2 pattern runs on a nightly build. Keeper backs the
         ON CLUSTER DDL queue and the Kafka offset/lock storage. -->
    <zookeeper>
        <node>
            <host>keeper</host>
            <port>9181</port>
        </node>
    </zookeeper>

    <!-- Two shards, one replica each. Referenced by Distributed(sharded, ...)
         and by ON CLUSTER 'sharded'. -->
    <remote_servers>
        <sharded>
            <shard>
                <internal_replication>false</internal_replication>
                <replica>
                    <host>ch-s1v2</host>
                    <port>9000</port>
                </replica>
            </shard>
            <shard>
                <internal_replication>false</internal_replication>
                <replica>
                    <host>ch-s2v2</host>
                    <port>9000</port>
                </replica>
            </shard>
        </sharded>
    </remote_servers>
</clickhouse>
