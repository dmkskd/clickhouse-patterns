<clickhouse>
    <!-- Development-only MinIO disk. Production credentials belong in a secret
         mechanism or environment-backed configuration, not this fragment. -->
    <storage_configuration>
        <disks>
            <cold_s3>
                <type>s3</type>
                <endpoint>http://minio:9000/clickhouse/ttl-tiered/</endpoint>
                <access_key_id>clickhouse</access_key_id>
                <secret_access_key>clickhouse_secret</secret_access_key>
            </cold_s3>
        </disks>
        <policies>
            <tiered>
                <volumes>
                    <hot>
                        <disk>default</disk>
                    </hot>
                    <cold>
                        <disk>cold_s3</disk>
                        <!-- Keep already-old inserts local; the test then
                             materializes TTL to demonstrate the move. -->
                        <perform_ttl_move_on_insert>0</perform_ttl_move_on_insert>
                    </cold>
                </volumes>
            </tiered>
        </policies>
    </storage_configuration>
</clickhouse>
